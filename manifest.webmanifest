{
  "name": "Ameenullah School Portal",
  "short_name": "Ameenullah",
  "description": "School management and result checking app for Ameenullah School of Arabic and Islamic Studies.",
  "id": "/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0B2E22",
  "theme_color": "#0B2E22",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Check Result",
      "short_name": "Result",
      "description": "Check published student results",
      "url": "./portal-login.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Parent Portal",
      "short_name": "Portal",
      "description": "Open the Parent & Student Portal",
      "url": "./portal.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Staff Login",
      "short_name": "Staff",
      "description": "Teacher & Admin Login",
      "url": "./login.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
