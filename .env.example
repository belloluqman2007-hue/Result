# Copy this file to .env and fill in real values.
# Never commit the actual .env file anywhere - it contains secrets.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=school_result_db

# MySQL connection variables (Railway style - alternative to DB_* above)
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
# or MYSQL_URL / DATABASE_URL for full connection string

# Generate a real random secret for production, e.g. by running this once:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Initial admin account - must be set before first run to seed admin user
ADMIN_DEFAULT_PASSWORD=choose-a-strong-admin-password

PORT=3000
NODE_ENV=production

# --- AI IMAGE GENERATOR ---
# Get your key at: https://platform.openai.com/api-keys
# Leave blank to disable the feature (the rest of the app works fine without it)
OPENAI_API_KEY=

# --- SEO / CANONICAL DOMAIN ---
# The app runs on two deployments of the same code:
#   Render:  https://result-cfn8.onrender.com/
#   Railway: https://result-production-69ea.up.railway.app/
# Google must index exactly ONE of them. The canonical tag, og:url,
# sitemap.xml and robots.txt all follow these settings, and every page
# visit that arrives at the NON-primary deployment gets a 301 redirect
# to the primary one. Defaults (if you set nothing): Render is primary.
#
# SITE_URL: full public URL used in the canonical/OG/JSON-LD/sitemap.
#           Leave blank to auto-use https://PRIMARY_HOST.
# SITE_URL=https://result-cfn8.onrender.com
#
# PRIMARY_HOST: the deployment that stays live and gets indexed; the
#               other one 301-redirects to it.
# PRIMARY_HOST=result-cfn8.onrender.com
#
# Set to "off" to disable the 301 redirect (canonical tags still apply).
# AMS_CANONICAL_REDIRECT=
